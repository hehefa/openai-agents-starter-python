{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cloudFunctions": {
    "nodejs": {
      "includeFiles": []
    }
  },
  "agents": {
    "timeout": 300,
    "framework": "openai-agents-sdk",
    "sandbox": {
      "timeout": 300
    }
  },
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://hefa.p4theater.cn https://p4theater.cn"
        }
      ]
    }
  ]
}
